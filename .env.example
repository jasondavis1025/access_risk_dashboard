# Copy to .env and set real values. .env is gitignored; never commit it.

# SQL Server SA password. Must meet SQL Server complexity rules:
# at least 8 characters, with three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=ChangeMe_UseAStrongPassword1!

# Host port for SQL Server (bound to 127.0.0.1 only).
MSSQL_PORT=1433

# Application database created by the sqlserver-init service.
MSSQL_DATABASE=AccessRiskDashboard
